rules_version = '2';

/* 部屋の紙はこの1コレクションだけ。挨拶（SDP）も手も、全部この紙に相乗りする。
   ホストはホストの欄、ゲストはゲストの欄にしか書けない。

   ★読む・消すルールに「書く中身」の条件を混ぜないこと。
     混ぜると request.resource が無く、読み取りが必ず403になる。 */
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{code} {

      allow get:  if request.auth != null;   // 番号を知っている人だけが1件読める
      allow list: if false;                  // 一覧は出せない（総当たりで覗かせない）

      // 作れるのは「自分がホストの、ゲストのいない部屋」だけ
      allow create: if request.auth != null
                    && request.resource.data.h == request.auth.uid
                    && !('g' in request.resource.data);

      allow update: if request.auth != null && (

          // ホスト：ホストの欄だけ
          (resource.data.h == request.auth.uid
           && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['hi','hu','hd','hn','hr','st','w','t']))

          // ゲスト：ゲストの欄だけ
       || (('g' in resource.data) && resource.data.g == request.auth.uid
           && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['gi','gu','gd','gn','gr','st','w','t']))

          // まだ誰もいない部屋に、自分をゲストとして入る
       || (!('g' in resource.data)
           && request.resource.data.g == request.auth.uid
           && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['g','gd','gn','gr','t'])));

      // 捨てられるのはホスト。3分放置された部屋は誰でも捨てられる
      allow delete: if request.auth != null
                    && (resource.data.h == request.auth.uid
                     || request.time.toMillis() - resource.data.t > 180000);
    }

    /* ─── 引き継ぎ用の保存。{code} が秘密そのもの ───
       知っている人だけが辿り着けるので、一覧は絶対に出さない。 */
    match /p/{code} {
      allow get: if request.auth != null;
      allow list: if false;                  // 総当たりで拾わせない
      allow create, update: if request.auth != null
                    && request.resource.data.keys().hasOnly(['name','rate','upd'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 24
                    && request.resource.data.rate is int
                    && request.resource.data.rate >= 0
                    && request.resource.data.rate <= 3600;
      allow delete: if false;
    }

    /* ─── 順位表。uid に縛るので他人の行は書けない ───
       サーバーで対局を検証していないので、せめて「1回の伸び」と「間隔」で縛る。
       99999 を書き込む類は止まる。時間をかければ少しは動かせるが、
       見返りに対して手間が大きい。 */
    match /rank/{uid} {
      allow get, list: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['name','rate','upd'])
                    && request.resource.data.rate is int
                    && request.resource.data.rate >= 0
                    && request.resource.data.rate <= 3600
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 24;
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['name','rate','upd'])
                    && request.resource.data.rate is int
                    && request.resource.data.rate >= 0
                    && request.resource.data.rate <= 3600
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 24
                    && (request.resource.data.rate - resource.data.rate) <= 80
                    && (resource.data.rate - request.resource.data.rate) <= 80
                    && request.time.toMillis() - resource.data.upd > 120000;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    /* ─── 通報。入れるだけ。誰にも読ませない ─── */
    match /reports/{id} {
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['by','name','kind','text','t'])
                    && request.resource.data.by == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 24
                    && request.resource.data.kind is string
                    && request.resource.data.kind.size() <= 24
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 500;
      allow get, list, update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
