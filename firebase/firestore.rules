rules_version = '2';

/* ランクマッチのマッチング専用。
   mm/{uid} は「いま相手を探している人」1人ぶん。対局データは一切通らない
   （手のやり取りは PeerJS の P2P で、端末どうしが直接つながる）。

   掴む側は相手のドキュメントを書き換える必要があるので、他人の update を
   限定的に許す。許すのは waiting → matched への1回だけで、
   rate と peer は書き換えさせない（なりすましで相手を差し替えられないように）。 */
service cloud.firestore {
  match /databases/{database}/documents {

    match /mm/{uid} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.state == 'waiting'
                    && request.resource.data.keys().hasOnly(['state','rate','peer','name','ts'])
                    && request.resource.data.ts is int
                    && request.resource.data.rate is int
                    && request.resource.data.rate >= 0
                    && request.resource.data.rate <= 100000
                    && request.resource.data.peer is string
                    && request.resource.data.peer.size() <= 64
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 24;

      /* 自分のものは常に。他人のものは 60秒より古いときだけ（落ちた端末の後始末） */
      allow delete: if request.auth != null
                    && ( request.auth.uid == uid
                         || request.time.toMillis() - resource.data.ts > 60000 );

      allow update: if request.auth != null && (
        request.auth.uid == uid
        || ( resource.data.state == 'waiting'
             && request.resource.data.state == 'matched'
             && request.resource.data.with == request.auth.uid
             && request.resource.data.rate == resource.data.rate
             && request.resource.data.peer == resource.data.peer
             && request.resource.data.name == resource.data.name
             && request.resource.data.opPeer is string
             && request.resource.data.opPeer.size() <= 64
             && request.resource.data.opName is string
             && request.resource.data.opName.size() <= 24
             && request.resource.data.opRate is int )
      );
    }

    match /{document=**} { allow read, write: if false; }
  }
}
